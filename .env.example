# Copy the web vars into apps/web/.env.local (Next.js reads env from the app folder).

# --- Dashboard (apps/web) ---
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
# Server-only. Never prefix with NEXT_PUBLIC_ and never expose to the browser.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# --- ML service (services/ml) ---
PREFLUX_LLM_PROVIDER=mock
