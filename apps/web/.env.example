# Copy this file to apps/web/.env.local and fill in the values. .env.local is git-ignored: never commit it.
# Supabase dashboard → Project Settings → API. Both values are safe for the browser (row-level security protects the data).
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
# No service-role key is needed anywhere in Preflux. Never add one here.
